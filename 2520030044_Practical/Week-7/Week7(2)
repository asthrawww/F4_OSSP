#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>
#include <fcntl.h>
#include <sys/stat.h>
#include <sys/wait.h>
#include <signal.h>
#include <string.h>

#define N 3

char c2s[N][50] = {
    "/tmp/client1_to_server",
    "/tmp/client2_to_server",
    "/tmp/client3_to_server"
};

char s2c[N][50] = {
    "/tmp/server_to_client1",
    "/tmp/server_to_client2",
    "/tmp/server_to_client3"
};

/* ================= SIGNAL HANDLER ================= */

void handler(int sig)
{
    if (sig == SIGUSR1)
        printf("\nReceived SIGUSR1\n");

    if (sig == SIGCHLD)
        waitpid(-1, NULL, WNOHANG);

    if (sig == SIGINT) {
        printf("\nProgram terminated.\n");
        exit(0);
    }
}

/* ================= SERVER HANDLER ================= */

void server_handler(int id)
{
    int r, w;
    char msg[100], reply[150];

    printf("Handler %d started (PID=%d)\n", id + 1, getpid());

    r = open(c2s[id], O_RDONLY);
    w = open(s2c[id], O_WRONLY);

    while (1) {
        memset(msg, 0, sizeof(msg));

        int n = read(r, msg, sizeof(msg) - 1);

        if (n <= 0)
            break;

        msg[n] = '\0';

        printf("Handler %d received: %s\n", id + 1, msg);

        if (strcmp(msg, "exit") == 0)
            break;

        sprintf(reply,
                "Server received from Client %d: %s",
                id + 1, msg);

        write(w, reply, strlen(reply));

        kill(getppid(), SIGUSR1);
    }

    close(r);
    close(w);

    printf("Handler %d terminated.\n", id + 1);

    exit(0);
}

/* ================= SERVER ================= */

void server()
{
    pid_t pid;

    signal(SIGUSR1, handler);
    signal(SIGCHLD, handler);
    signal(SIGINT, handler);

    printf("\n========== SERVER ==========\n");

    /* Create FIFOs */
    for (int i = 0; i < N; i++) {
        unlink(c2s[i]);
        unlink(s2c[i]);

        mkfifo(c2s[i], 0666);
        mkfifo(s2c[i], 0666);
    }

    printf("FIFOs created.\n");

    /* Create 3 handler processes */
    for (int i = 0; i < N; i++) {

        pid = fork();

        if (pid == 0) {
            server_handler(i);
        }
    }

    printf("Server PID = %d\n", getpid());
    printf("Waiting for clients...\n");

    while (1)
        pause();
}

/* ================= CLIENT ================= */

void client(int id)
{
    int w, r;
    char msg[100], reply[150];

    signal(SIGUSR1, handler);
    signal(SIGINT, handler);

    printf("\n========== CLIENT %d ==========\n", id);

    /* Open FIFOs */
    w = open(c2s[id - 1], O_WRONLY);
    r = open(s2c[id - 1], O_RDONLY);

    printf("Connected to server.\n");

    while (1) {

        printf("\nClient %d > ", id);
        fflush(stdout);

        fgets(msg, sizeof(msg), stdin);

        msg[strcspn(msg, "\n")] = '\0';

        /* Client -> Server */
        write(w, msg, strlen(msg));

        if (strcmp(msg, "exit") == 0)
            break;

        /* Server -> Client */
        memset(reply, 0, sizeof(reply));

        int n = read(r, reply, sizeof(reply) - 1);

        if (n > 0) {
            reply[n] = '\0';
            printf("Server: %s\n", reply);
        }
    }

    close(w);
    close(r);

    printf("Client %d terminated.\n", id);
}

/* ================= MAIN ================= */

int main(int argc, char *argv[])
{
    if (argc < 2) {
        printf("\nUsage:\n");
        printf("  Start server : %s server\n", argv[0]);
        printf("  Start client : %s client 1\n", argv[0]);
        printf("  Start client : %s client 2\n", argv[0]);
        printf("  Start client : %s client 3\n\n", argv[0]);
        return 1;
    }

    if (strcmp(argv[1], "server") == 0) {

        server();

    }
    else if (strcmp(argv[1], "client") == 0) {

        if (argc != 3) {
            printf("Enter client number 1, 2 or 3\n");
            return 1;
        }

        int id = atoi(argv[2]);

        if (id < 1 || id > 3) {
            printf("Client number must be 1, 2 or 3\n");
            return 1;
        }

        client(id);
    }
    else {
        printf("Invalid option.\n");
    }

    return 0;
}
