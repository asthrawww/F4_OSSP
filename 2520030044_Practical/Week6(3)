#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <sys/types.h>

#define MAX_INPUT 100

void processCommand(char *command) {

    if (strcmp(command, "hello") == 0) {
        printf("Hello! Welcome to MyShell.\n");
    }

    else if (strcmp(command, "help") == 0) {
        printf("Available commands:\n");
        printf("  hello - Display greeting\n");
        printf("  pdf   - Open PDF using xdg-open\n");
        printf("  exit  - Exit the shell\n");
    }

    else if (strcmp(command, "pdf") == 0) {

        pid_t pid = fork();

        if (pid < 0) {
            perror("fork failed");
        }

        else if (pid == 0) {
            // Child process
            printf("Child process created. PID = %d\n", getpid());

            execlp("xdg-open", "xdg-open",
                   "/home/student/Downloads/lecture_notes.pdf",
                   (char *)NULL);

            // Runs only if exec fails
            perror("exec failed");
            exit(1);
        }

        else {
            // Parent process
            printf("Parent process is still running. PID = %d\n", getpid());
        }
    }

    else if (strlen(command) == 0) {
        // Do nothing for empty input
    }

    else {
        printf("Unknown command: %s\n", command);
    }
}

int main() {

    char buffer[MAX_INPUT];

    while (1) {

        printf("myshell> ");
        fflush(stdout);

        fgets(buffer, sizeof(buffer), stdin);

        // Remove newline
        buffer[strcspn(buffer, "\n")] = '\0';

        // Check exit condition
        if (strcmp(buffer, "exit") == 0) {
            printf("Exiting shell...\n");
            break;
        }

        else {
            processCommand(buffer);
            fflush(stdout);
        }
    }

    return 0;
}
