#include <stdio.h>
#include <stdlib.h>
#include <fcntl.h>
#include <sys/mman.h>
#include <sys/stat.h>
#include <unistd.h>
#include <sys/wait.h>
#include <string.h>

#define SUBJECTS 5

int main() {
    int fd1, fd2;
    int *marks1, *marks2;
    pid_t p1, p2;

    /* Create shared memory for Student 1 */
    fd1 = shm_open("/student1_marks", O_CREAT | O_RDWR, 0666);
    if (fd1 == -1) {
        perror("shm_open student1");
        exit(1);
    }

    ftruncate(fd1, SUBJECTS * sizeof(int));

    marks1 = mmap(NULL, SUBJECTS * sizeof(int),
                  PROT_READ | PROT_WRITE,
                  MAP_SHARED, fd1, 0);

    /* Create shared memory for Student 2 */
    fd2 = shm_open("/student2_marks", O_CREAT | O_RDWR, 0666);
    if (fd2 == -1) {
        perror("shm_open student2");
        exit(1);
    }

    ftruncate(fd2, SUBJECTS * sizeof(int));

    marks2 = mmap(NULL, SUBJECTS * sizeof(int),
                  PROT_READ | PROT_WRITE,
                  MAP_SHARED, fd2, 0);

    /* Enter marks for Student 1 */
    printf("Enter marks for Student 1:\n");

    for (int i = 0; i < SUBJECTS; i++) {
        printf("Subject %d: ", i + 1);
        scanf("%d", &marks1[i]);
    }

    /* Enter marks for Student 2 */
    printf("\nEnter marks for Student 2:\n");

    for (int i = 0; i < SUBJECTS; i++) {
        printf("Subject %d: ", i + 1);
        scanf("%d", &marks2[i]);
    }

    printf("\nMarks successfully written to shared memory.\n");

    /* Start Student 1 */
    p1 = fork();

    if (p1 == 0) {
        execl("./student1", "student1", NULL);
        perror("exec student1 failed");
        exit(1);
    }

    /* Start Student 2 */
    p2 = fork();

    if (p2 == 0) {
        execl("./student2", "student2", NULL);
        perror("exec student2 failed");
        exit(1);
    }

    /* Teacher waits for both students */
    waitpid(p1, NULL, 0);
    waitpid(p2, NULL, 0);

    printf("\nBoth students completed their calculations.\n");

    /* Unmap shared memory */
    munmap(marks1, SUBJECTS * sizeof(int));
    munmap(marks2, SUBJECTS * sizeof(int));

    close(fd1);
    close(fd2);

    /* Remove shared memory objects */
    shm_unlink("/student1_marks");
    shm_unlink("/student2_marks");

    printf("Shared memory cleaned up.\n");

    return 0;
}
