#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <termios.h>

#define MAX_INPUT 100
#define MAX_HISTORY 50

char history[MAX_HISTORY][MAX_INPUT];
int history_count = 0;

struct termios original;

/* Enable non-canonical mode */
void enableRawMode() {
    struct termios raw;

    tcgetattr(STDIN_FILENO, &original);
    raw = original;

    raw.c_lflag &= ~(ICANON | ECHO);

    raw.c_cc[VMIN] = 1;
    raw.c_cc[VTIME] = 0;

    tcsetattr(STDIN_FILENO, TCSAFLUSH, &raw);
}

/* Restore terminal */
void disableRawMode() {
    tcsetattr(STDIN_FILENO, TCSAFLUSH, &original);
}

/* Add command to history */
void addHistory(char *command) {

    if (strlen(command) == 0)
        return;

    if (history_count < MAX_HISTORY) {
        strcpy(history[history_count], command);
        history_count++;
    }
    else {
        /* Shift old commands */
        for (int i = 1; i < MAX_HISTORY; i++)
            strcpy(history[i - 1], history[i]);

        strcpy(history[MAX_HISTORY - 1], command);
    }
}

/* Display history */
void showHistory() {

    for (int i = 0; i < history_count; i++)
        printf("%d  %s\n", i + 1, history[i]);
}

/* Clear current input line */
void clearLine() {
    printf("\33[2K\r");
    printf("myshell> ");
    fflush(stdout);
}

/* Display command in input buffer */
void displayBuffer(char *buffer) {
    clearLine();
    printf("%s", buffer);
    fflush(stdout);
}

int main() {

    char buffer[MAX_INPUT];
    int length;
    int history_index;

    enableRawMode();

    while (1) {

        memset(buffer, 0, sizeof(buffer));
        length = 0;

        /*
         * history_index:
         * -1 means normal input
         * 0 means oldest history entry
         */
        history_index = -1;

        printf("myshell> ");
        fflush(stdout);

        while (1) {

            char c;

            /* Read one character */
            if (read(STDIN_FILENO, &c, 1) != 1)
                continue;

            /* ENTER key */
            if (c == '\n' || c == '\r') {

                buffer[length] = '\0';

                printf("\n");

                /* Exit */
                if (strcmp(buffer, "exit") == 0) {
                    disableRawMode();
                    printf("Exiting shell...\n");
                    return 0;
                }

                /* History command */
                if (strcmp(buffer, "history") == 0) {
                    addHistory(buffer);
                    showHistory();
                }
                else {
                    addHistory(buffer);
                    printf("You entered: %s\n", buffer);
                }

                break;
            }

            /* BACKSPACE */
            else if (c == 127 || c == 8) {

                if (length > 0) {
                    length--;
                    buffer[length] = '\0';

                    /* Move back, erase character, move back */
                    printf("\b \b");
                    fflush(stdout);
                }
            }

            /* ESCAPE SEQUENCE */
            else if (c == 27) {

                char seq[2];

                /*
                 * Arrow keys send:
                 * UP    = ESC [ A
                 * DOWN  = ESC [ B
                 */
                if (read(STDIN_FILENO, &seq[0], 1) != 1)
                    continue;

                if (seq[0] != '[')
                    continue;

                if (read(STDIN_FILENO, &seq[1], 1) != 1)
                    continue;

                /* UP ARROW */
                if (seq[1] == 'A') {

                    if (history_count == 0)
                        continue;

                    if (history_index == -1)
                        history_index = history_count - 1;
                    else if (history_index > 0)
                        history_index--;

                    strcpy(buffer, history[history_index]);
                    length = strlen(buffer);

                    displayBuffer(buffer);
                }

                /* DOWN ARROW */
                else if (seq[1] == 'B') {

                    if (history_index == -1)
                        continue;

                    if (history_index < history_count - 1) {

                        history_index++;

                        strcpy(buffer, history[history_index]);
                        length = strlen(buffer);

                        displayBuffer(buffer);
                    }
                    else {

                        /* Reached bottom - clear input */
                        history_index = -1;

                        memset(buffer, 0, sizeof(buffer));
                        length = 0;

                        clearLine();
                    }
                }
            }

            /* Normal character */
            else if (c >= 32 && c <= 126) {

                if (length < MAX_INPUT - 1) {

                    buffer[length++] = c;
                    buffer[length] = '\0';

                    putchar(c);
                    fflush(stdout);
                }
            }
        }
    }

    disableRawMode();

    return 0;
}
